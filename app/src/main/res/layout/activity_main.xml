<?xml version="1.0" encoding="utf-8"?>
<!-- 竖屏：与横屏同风格（全局渐变/自定义背景 + 暗色玻璃卡片 + 白色控件） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 自定义背景图（设置里选择后全屏铺满） -->
    <ImageView
        android:id="@+id/bgImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶部：状态行（横向） + 按钮行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg_dark"
            android:padding="10dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_caption"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="@string/loading" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <Button
                    android:id="@+id/btnScan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_glass_bg"
                    android:textColor="@android:color/white"
                    android:drawableTop="@drawable/ic_refresh"
                    android:drawableTint="@android:color/white"
                    android:drawablePadding="1dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:textSize="@dimen/text_caption"
                    android:text="@string/btn_scan" />

                <Button
                    android:id="@+id/btnHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/btn_glass_bg"
                    android:textColor="@android:color/white"
                    android:drawableTop="@drawable/ic_home"
                    android:drawableTint="@android:color/white"
                    android:drawablePadding="1dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:textSize="@dimen/text_caption"
                    android:text="@string/btn_home" />

                <Button
                    android:id="@+id/btnSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/btn_glass_bg"
                    android:textColor="@android:color/white"
                    android:drawableTop="@drawable/ic_settings"
                    android:drawableTint="@android:color/white"
                    android:drawablePadding="1dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:textSize="@dimen/text_caption"
                    android:text="@string/btn_settings" />
            </LinearLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:indeterminateTint="@android:color/white"
            style="?android:attr/progressBarStyleHorizontal" />

        <!-- 曲库列表（暗色玻璃项） -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

        <!-- 底部播放控制栏：玻璃卡片 + 阴影分隔 -->
        <LinearLayout
            android:id="@+id/playerBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/player_glass_bg"
            android:elevation="8dp"
            android:paddingStart="@dimen/space_4"
            android:paddingEnd="@dimen/space_4"
            android:paddingTop="@dimen/space_2"
            android:paddingBottom="@dimen/space_2"
            android:layout_marginStart="@dimen/space_3"
            android:layout_marginEnd="@dimen/space_3"
            android:layout_marginBottom="@dimen/space_3"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvNowPlaying"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="@dimen/text_body"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="@string/not_playing" />

                <ImageButton
                    android:id="@+id/btnFavorite"
                    android:layout_width="@dimen/touch_min"
                    android:layout_height="@dimen/touch_min"
                    android:src="@drawable/ic_heart_outline"
                    app:tint="@android:color/white"
                    android:background="@drawable/player_btn_bg"
                    android:padding="10dp"
                    android:scaleType="centerInside"
                    android:contentDescription="收藏" />
            </LinearLayout>

            <!-- 进度条 + 两端时长 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/space_1">

                <TextView
                    android:id="@+id/tvTimeCur"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/player_time"
                    android:text="@string/time_zero" />

                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_2"
                    android:layout_marginEnd="@dimen/space_2"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@android:color/white"
                    android:progressBackgroundTint="@color/player_track"
                    android:thumbTint="@android:color/white" />

                <TextView
                    android:id="@+id/tvTimeTot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/player_time"
                    android:text="@string/time_empty" />
            </LinearLayout>

            <!-- 控制按钮行：ConstraintLayout + Guideline 百分比定位 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="2dp">

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guideMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.10" />
                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guidePrev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.30" />
                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guidePlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.50" />
                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guideNext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.70" />
                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guideQueue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.90" />

                <ImageButton
                    android:id="@+id/btnPlayMode"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:src="@drawable/ic_mode_order"
                    app:tint="@android:color/white"
                    android:background="@drawable/player_btn_bg"
                    android:padding="4dp"
                    android:scaleType="centerInside"
                    android:contentDescription="播放模式"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintWidth_percent="0.12"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@id/guideMode"
                    app:layout_constraintEnd_toEndOf="@id/guideMode" />

                <ImageButton
                    android:id="@+id/btnPrev"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:src="@drawable/ic_skip_previous"
                    app:tint="@android:color/white"
                    android:background="@drawable/player_btn_bg"
                    android:padding="4dp"
                    android:scaleType="centerInside"
                    android:contentDescription="上一曲"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintWidth_percent="0.12"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@id/guidePrev"
                    app:layout_constraintEnd_toEndOf="@id/guidePrev" />

                <ImageButton
                    android:id="@+id/btnPlayPause"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:src="@drawable/ic_play"
                    android:background="@drawable/player_btn_bg"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:contentDescription="播放或暂停"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintWidth_percent="0.17"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@id/guidePlay"
                    app:layout_constraintEnd_toEndOf="@id/guidePlay" />

                <ImageButton
                    android:id="@+id/btnNext"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:src="@drawable/ic_skip_next"
                    app:tint="@android:color/white"
                    android:background="@drawable/player_btn_bg"
                    android:padding="4dp"
                    android:scaleType="centerInside"
                    android:contentDescription="下一曲"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintWidth_percent="0.12"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@id/guideNext"
                    app:layout_constraintEnd_toEndOf="@id/guideNext" />

                <ImageButton
                    android:id="@+id/btnBarQueue"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:src="@drawable/ic_queue"
                    app:tint="@android:color/white"
                    android:background="@drawable/player_btn_bg"
                    android:padding="4dp"
                    android:scaleType="centerInside"
                    android:contentDescription="播放列表"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintWidth_percent="0.12"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@id/guideQueue"
                    app:layout_constraintEnd_toEndOf="@id/guideQueue" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 竖屏全屏播放页（点底部播放栏展开，根 FrameLayout 直下实现真正全屏覆盖） -->
    <FrameLayout
        android:id="@+id/playerPage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <View
            android:id="@+id/pageBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/bgImagePage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="@null" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="20dp">

            <!-- 水平 Guideline：封面占 50% 高度，其余留给文字+控制 -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideCoverBottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.55" />

            <!-- 左上角：返回主页 -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/ic_chevron_down"
                app:tint="@android:color/white"
                android:background="@drawable/player_btn_bg"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:contentDescription="返回"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintWidth_percent="0.12"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- 大封面：宽度 70%，1:1 比例 -->
            <FrameLayout
                android:id="@+id/coverContainer"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintWidth_percent="0.70"
                app:layout_constraintTop_toBottomOf="@id/btnBack"
                app:layout_constraintBottom_toTopOf="@id/guideCoverBottom"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="12dp">

                <View
                    android:id="@+id/albumArtBig"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/album_art_circle" />

                <ImageView
                    android:id="@+id/albumArtImageBig"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/noteIconBig"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_music_note"
                    android:contentDescription="@null"
                    app:tint="@android:color/white" />
            </FrameLayout>

            <!-- 歌名 -->
            <TextView
                android:id="@+id/tvPageTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textSize="@dimen/text_display"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:scrollHorizontally="true"
                android:text="@string/not_playing"
                app:layout_constraintTop_toBottomOf="@id/guideCoverBottom"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 歌手 -->
            <TextView
                android:id="@+id/tvPageArtist"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="@dimen/text_body"
                android:textColor="@color/player_text_dim"
                android:singleLine="true"
                android:ellipsize="end"
                android:text=""
                app:layout_constraintTop_toBottomOf="@id/tvPageTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 当前句歌词 -->
            <TextView
                android:id="@+id/tvPageLyric"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textSize="@dimen/text_body"
                android:textColor="@android:color/white"
                android:singleLine="true"
                android:ellipsize="end"
                android:text=""
                app:layout_constraintTop_toBottomOf="@id/tvPageArtist"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 进度条 + 两端时长 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintBottom_toTopOf="@id/controlRow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginBottom="@dimen/space_2">

                <TextView
                    android:id="@+id/tvPageTimeCur"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/player_time"
                    android:text="@string/time_zero" />

                <SeekBar
                    android:id="@+id/seekBarPage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_2"
                    android:layout_marginEnd="@dimen/space_2"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@android:color/white"
                    android:progressBackgroundTint="@color/player_track"
                    android:thumbTint="@android:color/white" />

                <TextView
                    android:id="@+id/tvPageTimeTot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/player_time"
                    android:text="@string/time_empty" />
            </LinearLayout>

            <!-- 控制行：ConstraintLayout + Guideline 百分比定位 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/controlRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guidePageMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.10" />
                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guidePagePrev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.30" />
                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guidePagePlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.50" />
                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guidePageNext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.70" />
                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guidePageQueue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.90" />

                <ImageButton
                    android:id="@+id/btnPageMode"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:src="@drawable/ic_mode_order"
                    app:tint="@android:color/white"
                    android:background="@drawable/player_btn_bg"
                    android:padding="4dp"
                    android:scaleType="centerInside"
                    android:contentDescription="播放模式"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintWidth_percent="0.12"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@id/guidePageMode"
                    app:layout_constraintEnd_toEndOf="@id/guidePageMode" />

                <ImageButton
                    android:id="@+id/btnPagePrev"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:src="@drawable/ic_skip_previous"
                    app:tint="@android:color/white"
                    android:background="@drawable/player_btn_bg"
                    android:padding="4dp"
                    android:scaleType="centerInside"
                    android:contentDescription="上一曲"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintWidth_percent="0.12"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@id/guidePagePrev"
                    app:layout_constraintEnd_toEndOf="@id/guidePagePrev" />

                <ImageButton
                    android:id="@+id/btnPagePlay"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:src="@drawable/ic_play"
                    android:background="@drawable/player_btn_bg"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:contentDescription="播放或暂停"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintWidth_percent="0.17"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@id/guidePagePlay"
                    app:layout_constraintEnd_toEndOf="@id/guidePagePlay" />

                <ImageButton
                    android:id="@+id/btnPageNext"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:src="@drawable/ic_skip_next"
                    app:tint="@android:color/white"
                    android:background="@drawable/player_btn_bg"
                    android:padding="4dp"
                    android:scaleType="centerInside"
                    android:contentDescription="下一曲"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintWidth_percent="0.12"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@id/guidePageNext"
                    app:layout_constraintEnd_toEndOf="@id/guidePageNext" />

                <ImageButton
                    android:id="@+id/btnPageQueue"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:src="@drawable/ic_queue"
                    app:tint="@android:color/white"
                    android:background="@drawable/player_btn_bg"
                    android:padding="4dp"
                    android:scaleType="centerInside"
                    android:contentDescription="播放列表"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintWidth_percent="0.12"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@id/guidePageQueue"
                    app:layout_constraintEnd_toEndOf="@id/guidePageQueue" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>

    <!-- 播放列表弹层（根层级：主页播放栏 / 播放页都能弹出） -->
    <FrameLayout
        android:id="@+id/queuePanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <View
            android:id="@+id/queueScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#80000000" />

        <LinearLayout
            android:id="@+id/queueCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:orientation="vertical"
            android:background="@drawable/queue_panel_bg"
            android:paddingTop="16dp"
            android:paddingStart="18dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvQueueTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_title"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:text="@string/queue_title" />

                <ImageButton
                    android:id="@+id/btnQueueClose"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="@android:color/white"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="收起" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/queueList"
                android:layout_width="match_parent"
                android:layout_height="420dp"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:paddingBottom="8dp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
