<?xml version="1.0" encoding="utf-8"?>
<!-- 设置对话框：ScrollView 包裹（横屏内容超出一屏可滚动）+ 暗色主题 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:text="@string/settings_title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textSize="12sp"
            android:textColor="@color/player_text_dim"
            android:text="@string/settings_server_url" />

        <EditText
            android:id="@+id/etUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/input_bg_dark"
            android:padding="12dp"
            android:hint="https://your.webdav.server/path"
            android:textColorHint="@color/player_text_dim"
            android:textColor="@android:color/white"
            android:inputType="textUri"
            android:textSize="14sp"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textSize="12sp"
            android:textColor="@color/player_text_dim"
            android:text="@string/settings_username" />

        <EditText
            android:id="@+id/etUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/input_bg_dark"
            android:padding="12dp"
            android:hint="trae"
            android:textColorHint="@color/player_text_dim"
            android:textColor="@android:color/white"
            android:inputType="text"
            android:textSize="14sp"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textSize="12sp"
            android:textColor="@color/player_text_dim"
            android:text="@string/settings_password" />

        <EditText
            android:id="@+id/etPass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/input_bg_dark"
            android:padding="12dp"
            android:hint="••••••••"
            android:textColorHint="@color/player_text_dim"
            android:textColor="@android:color/white"
            android:inputType="textPassword"
            android:textSize="14sp"
            android:singleLine="true" />

        <android.widget.Switch
            android:id="@+id/switchTrustSelfSigned"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_trust_self_signed"
            android:textColor="@android:color/white"
            android:textSize="13sp" />

        <android.widget.Switch
            android:id="@+id/switchAutoResume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_auto_resume"
            android:textColor="@android:color/white"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textSize="12sp"
            android:textColor="@color/player_text_dim"
            android:text="@string/settings_custom_bg" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <Button
                android:id="@+id/btnPickBg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_glass_bg"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:text="@string/settings_pick_bg" />

            <Button
                android:id="@+id/btnClearBg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/btn_glass_bg"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:text="@string/settings_reset_bg" />
        </LinearLayout>

        <Button
            android:id="@+id/btnTheme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_glass_bg"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:text="@string/dialog_title_theme" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textSize="12sp"
            android:textColor="@color/player_text_dim"
            android:text="@string/settings_cache" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical">

            <android.widget.Switch
                android:id="@+id/switchCache"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_cache_enable"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnCacheSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/btn_glass_bg"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:text="@string/settings_cache_size_default" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvCacheUsed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:textColor="@color/player_text_dim"
                android:text="@string/settings_cache_used_default" />

            <Button
                android:id="@+id/btnCacheClear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_glass_bg"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:text="@string/settings_cache_clear" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="8dp" />
    </LinearLayout>
</ScrollView>
